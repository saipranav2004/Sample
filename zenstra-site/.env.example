# Copy to .env and fill in. Never commit .env.
# Production: ./deploy.sh checks these and tells you what is missing.

# The site's domain. Its DNS must point at this server; ports 80 and 443 open.
DOMAIN=
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=
# Outgoing email: smtp://user:pass@host:587 or smtps://user:pass@host:465
# (Local development with the dev profile: smtp://mailpit:1025)
SMTP_URL=
# Who receives demo requests (comma-separated).
SALES_EMAIL=

# --- Optional ---------------------------------------------------------------
# Sender of the emails. Default: Zenstra <no-reply@DOMAIN>
MAIL_FROM=
# Only behind a TLS-inspecting corporate proxy: its CA certificate, used while
# installing packages during the image build.
BUILD_CA_FILE=
