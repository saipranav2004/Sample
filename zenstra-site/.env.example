# Copy to .env and fill in. Never commit .env.

# Deploy with ./deploy.sh (production: HTTPS, backups, log rotation). For a
# local run: docker compose --profile dev up -d --build, then http://localhost:8080

# --- Required ---------------------------------------------------------------
# Production domain. Its DNS must point at the host; ports 80 and 443 open.
DOMAIN=
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=
# Public address of the site, used in links in emails and canonical URLs.
# Production: https://<DOMAIN>
PUBLIC_URL=http://localhost:8080
# Origins allowed to post the forms (comma-separated). Usually PUBLIC_URL.
ALLOWED_ORIGINS=http://localhost:8080
# Database password. Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
# Salt for hashing visitor IP addresses (raw IPs are never stored). 32+ chars.
# Generate: openssl rand -hex 32
IP_HASH_SALT=

# --- Build -------------------------------------------------------------------
# Only behind a TLS-inspecting corporate proxy: path to its CA certificate, used
# while installing packages during the image build.
BUILD_CA_FILE=

# --- Web server -------------------------------------------------------------
WEB_PORT=8080
SERVER_NAME=_
# CIDR of your load balancer, so nginx logs and limits the real client IP.
REAL_IP_FROM=127.0.0.1
# Set automatically by the production compose file. For other HTTPS setups:
# HSTS=max-age=63072000; includeSubDomains
HSTS=
# Extra script and frame origins for the CSP. Needed for Turnstile and for an
# embedded scheduler, for example:
# CSP_SCRIPT_EXTRA=https://challenges.cloudflare.com
# CSP_FRAME_SRC=https://challenges.cloudflare.com https://cal.com
CSP_SCRIPT_EXTRA=
CSP_FRAME_SRC="'none'"

# --- Email (sales notifications and confirmations) ----------
# smtp://user:pass@host:587  or  smtps://user:pass@host:465
# Local development with the dev profile: smtp://mailpit:1025
SMTP_URL=
MAIL_FROM=Zenstra <hello@zenstra.ai>
SALES_NOTIFY_EMAILS=
SALES_REPLY_TO=
COMPANY_NAME=Zenstra AI
COMPANY_ADDRESS=8 The Green, Suite B, Dover, DE 19901, USA

# --- Instant booking ----------------------------------------------------------
# Scheduler shown right after a demo request. {name}, {email} and {ref} are
# filled in. Examples:
#   https://cal.com/zenstra/technical-session?name={name}&email={email}&embed=true
#   https://calendly.com/zenstra/technical-session?name={name}&email={email}
# Remember to allow its origin in CSP_FRAME_SRC.
BOOKING_URL=

# --- Integrations (each is optional) -----------------------------------------
SLACK_WEBHOOK_URL=
HUBSPOT_PORTAL_ID=
HUBSPOT_DEMO_FORM_ID=
# Any CRM or automation endpoint. Signed: header x-zenstra-signature: t=<unix>,v1=<hex HMAC-SHA256 of "t.body">
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Bot protection -----------------------------------------------------------
# Cloudflare Turnstile. Without it, the honeypot, timing check and rate limits still apply.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Backups (production) -------------------------------------------------------
# Nightly pg_dump; dumps older than this are deleted.
BACKUP_KEEP_DAYS=14

# --- Tuning -------------------------------------------------------------------
LOG_LEVEL=info
CONSENT_VERSION=2026-10
LEAD_RETENTION_DAYS=730
RATE_LIMIT_PER_MINUTE=5
EMAIL_DOMAIN_CHECK=true
