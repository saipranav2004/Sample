# NHI Console - production web tier.
#
# A template, not the final configuration. The official nginx image runs
# `envsubst` over /etc/nginx/templates/*.template at container start and writes
# the result into /etc/nginx/conf.d, so the values below are resolved at RUN
# time rather than baked into an image layer. That is the point: the Secret
# Scanner dashboard key must never exist inside an image, a git object, or the
# JavaScript bundle.
#
# Substituted at start (see NGINX_ENVSUBST_FILTER in the Dockerfile, which
# limits substitution to exactly these four names so nginx's own $variables
# survive untouched):
#   ${SCANNER_UPSTREAM}       e.g. https://js-dev.adapid.link
#   ${SCANNER_DASHBOARD_KEY}  the key the scanner issued
#   ${API_UPSTREAM}           e.g. http://nhi-api:8080
#   ${DNS_RESOLVER}           127.0.0.11 under Docker, the cluster DNS on K8s
#
# Three responsibilities, in the order a request meets them:
#   1. /secret-scanner/*  reverse proxy that attaches X-Dashboard-Key here,
#                         server side, so the browser never holds it.
#   2. /api/*             reverse proxy to the Go NHI Discovery API. The
#                         browser's own bearer token is forwarded unchanged.
#   3. everything else    the single-page app, with index.html as the fallback
#                         so a deep link survives a hard refresh.

# Both upstreams are addressed through variables, which makes nginx resolve
# them per request instead of at startup. Without this, a compose stack whose
# API container has not come up yet would prevent nginx from starting at all -
# the web tier should serve its own error states, not fail to boot.
resolver ${DNS_RESOLVER} valid=30s ipv6=off;
resolver_timeout 5s;

server {
    # IPv4 only, deliberately. `listen [::]:8080` makes nginx refuse to start
    # outright on a host without IPv6 - which includes many container runtimes
    # and CI environments - and a container bound to 0.0.0.0 is reachable in a
    # dual-stack network anyway, because the runtime maps the published port.
    # Add the IPv6 line only where IPv6 is known to be present.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the version to anyone probing the service.
    server_tokens off;

    # Uploads are not a feature of this app; the only writes it makes are small
    # JSON bodies to the allowlist endpoint.
    client_max_body_size 1m;

    # Compress what benefits from it. Images and fonts arrive compressed
    # already, so re-compressing them only burns CPU.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # ── 1. Secret Scanner ───────────────────────────────────────────────────
    # The browser calls /secret-scanner/api/findings; the scanner serves
    # /api/findings. `rewrite ... break` performs that strip, rather than a
    # trailing slash on proxy_pass: when proxy_pass carries a variable, nginx
    # does not rewrite the location prefix, so the slash form would forward the
    # path unchanged and every call would 404.
    location /secret-scanner/ {
        # `set` comes FIRST, and the order is load-bearing: `set` runs in the
        # rewrite phase, and `rewrite ... break` ends that phase, so a `set`
        # placed after it never executes and proxy_pass receives an empty
        # variable - a 500 on every scanner call. Verified by running it.
        set $scanner_upstream "${SCANNER_UPSTREAM}";
        rewrite ^/secret-scanner/(.*)$ /$1 break;
        proxy_pass $scanner_upstream;

        # The reason this location exists. Set, not merely forwarded: a
        # client-supplied X-Dashboard-Key is overwritten, so nobody can reach
        # the scanner through this service with a key of their own choosing.
        proxy_set_header X-Dashboard-Key "${SCANNER_DASHBOARD_KEY}";

        # The scanner is addressed over TLS by name, so SNI and the Host header
        # must both carry the upstream's hostname, not this server's.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;

        # Nothing else the browser sent needs to reach the scanner. The app's
        # bearer token and cookies belong to the other API, and forwarding
        # credentials to a third party that has no use for them is how they end
        # up in somebody else's logs.
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        # A findings list is a live view; a cached copy of it is a wrong answer.
        proxy_buffering off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # ── 2. NHI Discovery API ────────────────────────────────────────────────
    # This upstream serves the /api prefix itself, so the path is forwarded
    # unchanged - no rewrite.
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        # A scan listing can take a while to answer; the UI holds a skeleton
        # while it does.
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # ── 3. The single-page app ──────────────────────────────────────────────
    # Fingerprinted assets are immutable: the filename changes whenever the
    # contents do, so a year of caching can never serve a stale one.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        # Set through add_header rather than `expires`, which emits a
        # Cache-Control of its own and would send the header twice.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # Brand files are referenced by stable names, so they get a short cache
    # with revalidation rather than a year.
    location /brand/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
    }

    # index.html is never cached: it is the document that names which asset
    # bundle to load, so a cached copy pins a browser to a deployment that no
    # longer exists.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    # Client-side routing: /genome/some-identity is a route, not a file, so
    # anything not on disk is answered with the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Health ──────────────────────────────────────────────────────────────
    # Answered by nginx alone, with no upstream call. This reports whether the
    # web tier is serving, which is what a liveness probe asks. Whether the two
    # APIs are reachable is a different question, and the app already answers
    # that on screen rather than by failing to start.
    location = /healthz {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    # Do not serve dotfiles, whatever ends up in the image.
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
