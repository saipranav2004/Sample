# Copy this file to `.env` (same folder as vite.config.js) and fill in the key.
# `.env` is git-ignored and is never shipped in a release zip, so a key you put
# there is not overwritten when you unpack a new build over this folder.

# ── Core NHI Discovery API (Go service in aws-backend) ─────────────────────────
# Left blank in development so requests go through the Vite proxy.
VITE_API_URL=

# ── Secret Scanner API (external service, see API_Integration_Guide) ──────────
# Path the browser talks to. Whatever serves it attaches X-Dashboard-Key
# server-side: the Vite dev proxy locally, nginx in production.
VITE_SCANNER_BASE_PATH=/secret-scanner

# Read by vite.config.js on the Node side only - never bundled into client code.
# NO `VITE_` prefix on the key: every VITE_ variable is sent to the browser.
# On `npm run dev` the terminal prints one line confirming whether the key was
# found and how long it is (never its value):
#   [scanner proxy] upstream https://js-dev.adapid.link; SCANNER_DASHBOARD_KEY is set (NN characters)
# Restart the dev server after changing either value - Vite reads them once.
SCANNER_UPSTREAM=https://js-dev.adapid.link
SCANNER_DASHBOARD_KEY=
