# ── Core NHI Discovery API (Go service in aws-backend) ─────────────────────────
# Left blank in development so requests go through the Vite proxy below.
VITE_API_URL=

# ── Secret Scanner API (external service, see API_Integration_Guide) ──────────
# Path the browser talks to. It must be served by something that can attach the
# X-Dashboard-Key header server-side. In development that is the Vite proxy
# configured in vite.config.js; in production it must be your own backend route
# or reverse proxy. The key itself is NEVER shipped to the browser.
VITE_SCANNER_BASE_PATH=/secret-scanner

# Read by vite.config.js (Node side only, never bundled into client code).
SCANNER_UPSTREAM=https://js-dev.adapid.link
SCANNER_DASHBOARD_KEY=
